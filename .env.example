# docker compose 용 설정 예시. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   Copy-Item .env.example .env
# .env 는 .gitignore / .dockerignore 로 제외돼 저장소 · 이미지에 들어가지 않습니다.
# (실제 비밀번호를 이 예시 파일에 적지 마세요)

# DB (MySQL root / 앱 계정 petclinic)
DB_ROOT_PASSWORD=
DB_APP_PASSWORD=

# 관리자 화면 로그인 (비우면 관리자 화면이 잠김)
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PATH=/staff-room
